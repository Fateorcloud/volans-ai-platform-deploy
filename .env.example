# =============================================================================
# AI Platform - Environment Template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
DB_USER=ai_admin
DB_PASS=replace_with_strong_password_32chars

# --- NewAPI master token ------------------------------------------------------
# IMPORTANT: Leave empty on first bring-up. After NewAPI boots, log in at the
# tunnel URL, create a token in the Tokens page, then paste it here and run
# `docker compose up -d` again to recreate open-webui with the token injected.
NEWAPI_MASTER_KEY=

# --- Cloudflare Tunnel --------------------------------------------------------
# Get from Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> Your tunnel
CF_TUNNEL_TOKEN=

# --- RAG / Embedding ----------------------------------------------------------
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_RERANKING_MODEL=

# --- Web loader (optional Playwright sidecar) ---------------------------------
# Default safe_web uses built-in cheerio, good for most pages.
# To enable Playwright: run `docker compose --profile browser up -d` and set:
#   WEB_LOADER_ENGINE=playwright
#   PLAYWRIGHT_WS_URL=ws://playwright:3000
WEB_LOADER_ENGINE=safe_web
PLAYWRIGHT_WS_URL=

# --- Image version pins (bump deliberately, never use latest in production) ---
POSTGRES_VERSION=15.8-alpine
NEWAPI_VERSION=latest
OPENWEBUI_VERSION=main
CLOUDFLARED_VERSION=latest
BROWSERLESS_VERSION=latest
