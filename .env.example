# =============================================================================
# AI Platform - Environment Template
# Copy to .env and fill real values. NEVER commit .env to version control.
# =============================================================================

# --- Install / network --------------------------------------------------------
INSTALL_TARGET=/opt/Serve
AI_NET_SUBNET=172.18.0.0/16
AI_NET_GATEWAY=172.18.0.1
PROXY_PORT=7890

# --- Public URLs --------------------------------------------------------------
WEBUI_URL=https://chat.example.com
CHAT_HOSTNAME=chat.example.com
ADMIN_HOSTNAME=admin.example.com
API_HOSTNAME=api.example.com

# --- PostgreSQL ---------------------------------------------------------------
DB_USER=ai_admin
DB_PASS=replace_with_strong_password_32chars

# --- NewAPI master token ------------------------------------------------------
# Leave empty on first bring-up. After NewAPI boots, create a token in NewAPI,
# paste it here, then recreate open-webui:
#   docker compose up -d --force-recreate open-webui
NEWAPI_MASTER_KEY=

# --- Open WebUI bootstrap / governance ---------------------------------------
WEBUI_SECRET_KEY=replace_with_random_secret
OPENWEBUI_ENABLE_PERSISTENT_CONFIG=False
OPENWEBUI_ENABLE_SIGNUP=true
OPENWEBUI_DEFAULT_USER_ROLE=pending
OPENWEBUI_ENABLE_SIGNUP_PASSWORD_CONFIRMATION=true
OPENWEBUI_ENABLE_DIRECT_CONNECTIONS=false
OPENWEBUI_ENABLE_API_KEYS=false
OPENWEBUI_USER_PERMISSIONS_FEATURES_API_KEYS=false
OPENWEBUI_BYPASS_MODEL_ACCESS_CONTROL=false
OPENWEBUI_PENDING_USER_OVERLAY_TITLE=Account pending review
OPENWEBUI_PENDING_USER_OVERLAY_CONTENT=Your account is waiting for administrator approval.

# Optional admin bootstrap helpers used by local runbooks/scripts only.
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=admin

# --- Open WebUI web search ----------------------------------------------------
OPENWEBUI_ENABLE_WEB_SEARCH=true
OPENWEBUI_WEB_SEARCH_ENGINE=duckduckgo
OPENWEBUI_BRAVE_SEARCH_API_KEY=
OPENWEBUI_WEB_SEARCH_RESULT_COUNT=3
OPENWEBUI_WEB_SEARCH_CONCURRENT_REQUESTS=1
OPENWEBUI_WEB_LOADER_ENGINE=safe_web
OPENWEBUI_WEB_LOADER_CONCURRENT_REQUESTS=3
OPENWEBUI_BYPASS_WEB_SEARCH_WEB_LOADER=false
OPENWEBUI_BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=false
OPENWEBUI_USER_PERMISSIONS_FEATURES_WEB_SEARCH=true

# --- Cloudflare Tunnel --------------------------------------------------------
# Get from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
CF_TUNNEL_TOKEN=

# --- Optional image playground stack -----------------------------------------
# Enable with:
#   docker compose -f docker-compose.yml -f docker-compose.image.yml --profile image up -d
IMAGE_HOSTNAME=image.example.com
IMAGE_PUBLIC_API_PROXY_URL=https://image.example.com/api-proxy
IMAGE_SHARED_API_KEY=
IMAGE_BASIC_AUTH_USER=volans-image
# Generate with: caddy hash-password --plaintext 'replace_me'
IMAGE_BASIC_AUTH_HASH=
IMAGE_HTTP_PORT=80
IMAGE_HTTPS_PORT=443
CADDY_ACME_EMAIL=admin@example.com

# --- Optional xui stack -------------------------------------------------------
# Enable xui with: (cd xui && docker compose up -d)
# If Cloudflare Tunnel must reach xui, also run the main stack with:
#   docker compose -f docker-compose.yml -f docker-compose.xui-tunnel.yml up -d cloudflared
XUI_VERSION=v3.0.2
XUI_REALITY_PORT=31444
XUI_CPUS=0.75
XUI_MEMORY_LIMIT=512m

# --- Image version pins -------------------------------------------------------
# For production, replace latest/main with tested immutable tags when possible.
POSTGRES_VERSION=15.8-alpine
NEWAPI_VERSION=latest
OPENWEBUI_VERSION=main
CLOUDFLARED_VERSION=latest
BROWSERLESS_VERSION=latest
GPT_IMAGE_PLAYGROUND_VERSION=latest
CADDY_VERSION=2-alpine
